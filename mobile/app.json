{
  "expo": {
    "name": "Whaticket Mobile",
    "slug": "whaticket-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "processing",
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#efe4cf"
      },
      "package": "com.anonymous.whaticketmobile",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "extra": {
      "apiUrl": "https://api-whaticket.digiyou.com.br"
    },
    "plugins": [
      "expo-secure-store",
      "expo-background-task",
      "expo-notifications",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": true,
          "microphonePermission": "Permita o uso do microfone para enviar audios no Whaticket Mobile.",
          "recordAudioAndroid": true
        }
      ]
    ]
  }
}

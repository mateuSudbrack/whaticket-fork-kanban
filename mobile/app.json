{
  "expo": {
    "name": "Whaticket Mobile",
    "slug": "whaticket-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "processing",
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#efe4cf"
      }
    },
    "extra": {
      "apiUrl": "https://api-whaticket.digiyou.com.br"
    },
    "plugins": [
      "expo-secure-store",
      "expo-background-task",
      "expo-notifications"
    ]
  }
}
